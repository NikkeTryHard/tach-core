{
  "permissions": {
    "allow": [
      "mcp__sequential-thinking__sequentialthinking",
      "Bash(cargo test:*)",
      "Bash(source:*)",
      "Bash(export PYO3_PYTHON=:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(git commit:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/pre_commit_check.py"
          }
        ]
      }
    ]
  }
}